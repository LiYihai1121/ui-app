        <!-- 安全配置（A 链：规则完整性签名 + 证书固定） -->
        <string name="settings_security_section">规则安全</string>
        <string name="settings_security_desc">规则签名密钥需与服务端 RULES_SIGNING_KEY 一致；未配置时客户端拒绝载入任何云端规则（防中间人篡改）。密钥保存在本设备，可被拥有设备控制权的人提取，请勿复用其他凭据。证书指纹为服务器证书公钥的 sha256/… 值（每行一个），仅 HTTPS 连接需要；配置后未匹配的证书将被拒绝。</string>
        <string name="settings_signing_key_label">规则签名密钥</string>
        <string name="settings_signing_key_hint">与服务端 RULES_SIGNING_KEY 相同，至少 16 位</string>
        <string name="settings_signing_key_too_short">签名密钥太短（至少 16 位），无法保证防篡改强度</string>
        <string name="settings_cert_pins_label">证书指纹（sha256/…，每行一个）</string>
        <string name="settings_cert_pins_hint">sha256/AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=</string>
        <string name="settings_cert_pin_invalid">证书指纹格式不正确：%1$s（应为 sha256/ 加 44 位标准 Base64）</string>
        <string name="settings_cleartext_warning">当前使用明文 HTTP：局域网内可能被窃听或篡改规则。防篡改依赖签名密钥，但建议尽快迁移 HTTPS 并配置证书指纹。</string>
